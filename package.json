{
  "name": "zhihu-article-to-video",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @zhihu-video/api --filter @zhihu-video/web dev",
    "desktop:dev": "pnpm --filter @zhihu-video/api build && pnpm --filter @zhihu-video/web build && pnpm --filter @zhihu-video/desktop dev",
    "desktop:make": "pnpm --filter @zhihu-video/api... build && pnpm --filter @zhihu-video/web... build && pnpm --filter @zhihu-video/desktop make",
    "desktop:make:win32": "pnpm --filter @zhihu-video/desktop package:win32",
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "lint": "pnpm --recursive --if-present run lint",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prettier": "latest",
    "typescript": "^5.7.3"
  }
}
