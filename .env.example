PORT=3001
DATA_DIR=./data
OUTPUT_DIR=./outputs
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash

# 批量任务并发数（可选 5/10/15/20，默认 5；知乎抓取环节始终串行限流，并发只作用于 AI 与渲染）
# TASK_CONCURRENCY=5

# 知乎内容读取（Playwright + 持久化浏览器会话）
# 浏览器按以下顺序自动探测：ZHIHU_BROWSER_EXECUTABLE_PATH → ZHIHU_BROWSER_CHANNEL
# → 本机 Chrome → 本机 Edge → 应用内置 Chromium → Playwright 默认浏览器
# ZHIHU_BROWSER_CHANNEL=chrome
# 指定浏览器可执行文件路径（最高优先级）
# ZHIHU_BROWSER_EXECUTABLE_PATH=/Applications/Chromium.app/Contents/MacOS/Chromium
# 指定内置 Chromium 可执行文件路径（桌面端打包后自动注入，一般无需手动设置）
# ZHIHU_BUNDLED_CHROMIUM_EXECUTABLE=
# 默认 headless 优先：读取全程无窗口；仅在遇到登录/安全验证/风控时自动弹出可见窗口重试
# 显式设为 false 可恢复旧行为（始终弹出可见窗口）
# ZHIHU_BROWSER_HEADLESS=true
# 两次页面读取的最小间隔（毫秒），避免触发频率风控
ZHIHU_READ_MIN_INTERVAL_MS=3000
