PORT=3001
DATA_DIR=./data
OUTPUT_DIR=./outputs
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash

# 知乎内容读取（Playwright + 本机真实浏览器会话）
# 默认使用系统 Chrome（channel=chrome），首次任务会弹出浏览器窗口，请在其中登录知乎
ZHIHU_BROWSER_CHANNEL=chrome
# 未安装 Chrome 时，改为指定浏览器可执行文件路径
# ZHIHU_BROWSER_EXECUTABLE_PATH=/Applications/Chromium.app/Contents/MacOS/Chromium
# 无界面环境才开启 headless（知乎风控可检测 headless，成功率会下降）
# ZHIHU_BROWSER_HEADLESS=false
# 两次页面读取的最小间隔（毫秒），避免触发频率风控
ZHIHU_READ_MIN_INTERVAL_MS=3000
